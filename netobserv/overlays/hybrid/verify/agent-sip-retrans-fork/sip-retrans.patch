 }
+
+func sipMethodToStr(m uint8) string {
+	switch m {
+	case 1:
+		return "INVITE"
+	case 2:
+		return "REGISTER"
+	case 3:
+		return "ACK"
+	case 4:
+		return "BYE"
+	case 5:
+		return "CANCEL"
+	case 6:
+		return "OPTIONS"
+	default:
+		return "OTHER"
+	}
+}
