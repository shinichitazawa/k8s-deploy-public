+	if other == nil {
+		return
+	}
+	p.buildBaseFromAdditional(other.StartMonoTimeTs, other.EndMonoTimeTs, other.EthProtocol)
+	if p.TcpRetransMetrics == nil {
+		p.TcpRetransMetrics = other
+		return
+	}
+	p.TcpRetransMetrics.Bytes += other.Bytes
+	p.TcpRetransMetrics.Packets += other.Packets
+	p.TcpRetransMetrics.LatestFlags |= other.LatestFlags
+	if p.TcpRetransMetrics.StartMonoTimeTs == 0 || (other.StartMonoTimeTs != 0 && other.StartMonoTimeTs < p.TcpRetransMetrics.StartMonoTimeTs) {
+		p.TcpRetransMetrics.StartMonoTimeTs = other.StartMonoTimeTs
+	}
+	if other.EndMonoTimeTs > p.TcpRetransMetrics.EndMonoTimeTs {
+		p.TcpRetransMetrics.EndMonoTimeTs = other.EndMonoTimeTs
+	}
+}
